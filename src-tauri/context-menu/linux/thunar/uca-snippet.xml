<?xml version="1.0" encoding="UTF-8"?>
<!--
  Thunar (XFCE) custom action.

  You do not normally need this file: Settings -> Right-Click "Send via
  wyrmhole" merges the <action> block below into ~/.config/Thunar/uca.xml
  for you, leaving any custom actions you already have untouched, and
  removes just that block when you toggle the setting back off.

  To do it by hand instead, paste the block inside the <actions> element of
  ~/.config/Thunar/uca.xml (back the file up first), then run: thunar -q

  Or via the GUI: Thunar -> Edit -> Configure custom actions... -> + (Add)
    Name:    Send via wyrmhole
    Command: wyrmhole %F
    Appearance Conditions -> File Pattern: *  -> tick every file type
-->
<action>
	<icon>wyrmhole</icon>
	<name>Send via wyrmhole</name>
	<unique-id>wyrmhole-send-via-wyrmhole</unique-id>
	<command>&quot;/usr/bin/wyrmhole&quot; %F</command>
	<description>Send the selected files/folders via wyrmhole</description>
	<patterns>*</patterns>
	<directories/>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>
